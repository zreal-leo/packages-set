{
    "name": "packages-set",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zreal-leo/packages-set.git"
    },
    "type": "module",
    "scripts": {
        "fmt": "oxfmt build packages",
        "lint": "npm run typecheck && oxlint --fix build packages",
        "prepare": "[ -n \"$CI\" ] || simple-git-hooks",
        "release": "changeset add && changeset version",
        "typecheck": "tsc --noEmit",
        "plop": "plop"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^25.9.3",
        "lint-staged": "^17.0.7",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "plop": "^4.0.5",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm run lint && pnpm exec lint-staged"
    },
    "lint-staged": {
        "*": [
            "oxfmt --write"
        ]
    },
    "packageManager": "pnpm@11.0.9"
}
